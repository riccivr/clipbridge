# Maintainer: Ricardo Veronese Ricci <ricci.vr@gmail.com>
pkgname=clipbridge
pkgver=1.3.0
pkgrel=1
pkgdesc="Universal clipboard bridge and background daemon powered by unipaste"
arch=('x86_64' 'aarch64' 'armv7h' 'i686')
url="https://github.com/riccivr/clipbridge"
license=('MIT')
depends=('glibc')
optdepends=(
	'wl-clipboard: Wayland clipboard support'
	'xclip: X11 clipboard support'
	'xsel: Alternative X11 clipboard support'
)
source=("https://github.com/riccivr/clipbridge/releases/download/v${pkgver}/clipbridge-${pkgver}.tar.gz")
sha256sums=('eb9cab4f0dae6150b4cf2c93898460853da7b30699392813db9757c33e007507')

build() {
	cd "${pkgname}-${pkgver}"
	make
}

package() {
	cd "${pkgname}-${pkgver}"
	make DESTDIR="${pkgdir}" PREFIX="/usr" install
	install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
